# Python bytecode — compiled files Python creates automatically
__pycache__/
*.py[cod]
*.pyo

# Virtual environment folders — your local Python environment
venv/
env/
.venv/
.env/

# Output files generated by the script
*.json
!sample_data/*.json

# OS-generated files
.DS_Store          # macOS
Thumbs.db          # Windows

# Editor/IDE folders
.vscode/
.idea/
*.swp

# Real log files — NEVER commit actual production logs
*.log
!sample_data/auth.log
